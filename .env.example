# --- Anthropic (Phase 1+; assistant/digest/narration) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Atlas runtime ---
ATLAS_ORG_ID=
ATLAS_LOG_LEVEL=info
PORT=3001
