# --- Supabase (Postgres + pgvector) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- Shopify (canonical sync + fulfillment webhook) ---
# With both set, the worker syncs the connection on its own cadence as a scheduled job
# (default every 15 minutes; per-source dispatch_sources.sync_every_minutes).
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# Location routing (Phase 0): main warehouse + known-venue locations
# Anything matching VENUE_LOCATION_IDS → consignment; SHOPIFY_MAIN_LOCATION_ID
# with a known wholesale customer → wholesale; else → ignored.
SHOPIFY_MAIN_LOCATION_ID=
VENUE_LOCATION_IDS=

# --- GoSweetSpot (carrier cost for first-part freight; server-side only) ---
# Shipments are booked in the GoSweetSpot website; Atlas reads their cost back.
# The access key is a server secret: set it in the worker/API host's secret store,
# never with a NEXT_PUBLIC_ prefix or in the console's environment.
GOSWEETSPOT_ACCESS_KEY=
GOSWEETSPOT_SITE_ID=
# Currency GoSweetSpot reports costs in (VICE: NZD) and how long a recorded cost may be used.
GOSWEETSPOT_COST_CURRENCY=
GOSWEETSPOT_COST_VALIDITY_DAYS=30

# --- Stripe (Phase 1; stub-only in Phase 0) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (narration; the daily briefing runs only with this key set AND the
# business's assistant.narrate grant enabled — the grant is never seeded) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Atlas runtime ---
ATLAS_ORG_ID=
ATLAS_LOG_LEVEL=info
PORT=3001
# Bearer token for /admin/* routes (drain, sync, replay). Generate with:
#   openssl rand -hex 32
# Unset = admin surface answers 503 (fails closed, never open).
ATLAS_API_TOKEN=
# Worker tick interval (outbox drain + projection replay). Default 60s.
WORKER_INTERVAL_MS=60000
# Identifies the trusted owner of ATLAS_API_TOKEN in approval/recovery audit records.
# Set explicitly before enabling administrative approval/execute endpoints.
ATLAS_ADMIN_ACTOR_ID=
# Technical approval expiry (seconds); bounded to 1..86400, default 3600.
ATLAS_APPROVAL_TTL_SECONDS=3600
