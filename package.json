{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas — vertical AI management platform (Jarvis for VICE). Phase 0: substrate + thin spine + canonical sync.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "tsx src/api/server.ts",
    "build-loop": "tsx scripts/build-loop/cli.ts",
    "sync:shopify": "tsx src/integrations/shopify/sync.ts",
    "test": "node --test --import tsx test/*.test.ts && node --test test/reviewer/*.test.mjs",
    "test:build-loop": "node --test --import tsx test/build_loop.test.ts",
    "test:reviewer": "node --test test/reviewer/*.test.mjs",
    "gen:types": "./scripts/gen-types.sh",
    "verify:migrations": "./scripts/verify-migrations.sh",
    "verify:parity": "tsx scripts/sql-ts-parity.ts",
    "verify:architecture": "node --test --import tsx test/architecture_contracts.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "stripe": "^22.2.1",
    "ws": "8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
