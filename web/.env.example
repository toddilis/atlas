# Atlas operator console.
#
# Server-side only — never exposed to client components. The service-role key bypasses
# RLS; every page verifies the operator session (middleware) BEFORE this client runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_ORG_ID=

# Auth (PR-P). The anon key is browser-safe by design — it only powers session handling
# (login form + middleware session refresh). Same Supabase project as above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated operator allowlist. FAILS CLOSED: empty/unset means nobody can pass
# the gate, even with a valid Supabase Auth account.
ATLAS_OPERATOR_EMAILS=operator@example.com
