# --- Hedera Testnet ---
# Create an account at https://portal.hedera.com/dashboard
# Both values are required; the kit will not start without them.
# Key type: prefer ECDSA (the portal default). Either ECDSA or ED25519 works,
# in DER- or hex-encoded form. Examples:
#   ECDSA (hex):   0xa526a7fb39655fab74a37194c0a1fc39240606bcc72a2488e2cb33151dce2b41
#   ED25519 (DER): 302e020100300506032b657004220420...
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=

# --- HCS topics ---
# Created by `npm run hedera:topics`. Cached in .topics.json; you can also
# pin them here so a fresh checkout reuses existing topics.
HCS_CONVERSIONS_TOPIC_ID=
HCS_AUDIT_TOPIC_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Demo ---
# A second Hedera testnet account id used as the creator-payee in the
# demo scenarios. Easiest source: portal "create account" again, or any
# friend's testnet id.
DEMO_RECIPIENT_ID=0.0.xxxxxx
